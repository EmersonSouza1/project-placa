POSTGRES_PASSWORD=local-poc-password
API_PORT=5080
# Mantenha a simulação até configurar a câmera/vídeo e a zona.
# Para câmera: SOURCE_MODE=video e VISION_BUILD_TARGET=inference.
SOURCE_MODE=simulation
# Taxa alvo de inferência no modo video (frames por segundo).
PROCESS_FPS=3
# Limite de frames aguardando processamento no modo video.
FRAME_QUEUE_SIZE=5
# Teste com placa no celular: SOURCE_MODE=ocr_test (usa inference, sem plate.pt).
VISION_BUILD_TARGET=simulation
# Use credenciais reais somente no .env local, sem barras de escape Markdown.
VIDEO_SOURCE='rtsp://usuario:senha@camera.local:554/cam/realmonitor?channel=1&subtype=1'
CAMERA_ID=camera-01
DOCK_ID=dock-01
ZONE_PATH=/config/zone.json
VEHICLE_MODEL=yolo11n.pt
OCR_ENABLED=false
PLATE_MODEL=/models/plate.pt
DEVICE=cpu
